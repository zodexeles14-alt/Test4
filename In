* {
  box-sizing: border-box;
}

:root {
  --bg: #f7f8f6;
  --surface: #ffffff;
  --text: #111512;
  --muted: #69716b;
  --line: #dfe4df;
  --accent: #18a957;
  --accent-dark: #087a39;
  --dark: #111713;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Inter, Arial, sans-serif;
}

.container {
  width: min(1180px, 92%);
  margin: 0 auto;
  padding: 60px 0;
}

.hero-split {
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  gap: 60px;
  align-items: center;
}

.tagline {
  color: var(--accent-dark);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.main-title {
  margin: 14px 0 20px;
  font-size: clamp(42px, 6vw, 76px);
  line-height: .98;
  letter-spacing: -3px;
}

.main-title span {
  color: var(--accent);
}

.description {
  max-width: 650px;
  color: var(--muted);
  font-size: 17px;
  line-height: 1.7;
}

.btn-start {
  margin-top: 20px;
  padding: 15px 22px;
  border: 0;
  background: var(--dark);
  color: white;
  font-weight: 800;
  cursor: pointer;
  transition: .25s ease;
}

.btn-start:hover {
  background: var(--accent);
  transform: translateY(-2px);
}

.terminal-card {
  min-height: 300px;
  padding: 22px;
  border-radius: 16px;
  background: #101510;
  color: #dce8df;
  box-shadow: 0 25px 60px rgba(0,0,0,.12);
}

.terminal-dots {
  display: flex;
  gap: 7px;
  margin-bottom: 30px;
}

.dot {
  width: 11px;
  height: 11px;
  border-radius: 50%;
}

.dot.red { background: #ff5f57; }
.dot.yellow { background: #ffbd2e; }
.dot.green { background: #28c840; }

.terminal-code {
  font-family: Consolas, monospace;
  font-size: 15px;
  line-height: 2;
}

.code-key {
  color: #7dd3fc;
}

.code-val-bool {
  color: #86efac;
}

.code-val-str {
  color: #facc15;
}

.stats-bar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 70px 0 45px;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.stat-item {
  padding: 25px;
  text-align: center;
}

.stat-item + .stat-item {
  border-left: 1px solid var(--line);
}

.stat-item h3 {
  margin: 0;
  font-size: 34px;
}

.stat-item p {
  margin: 7px 0 0;
  color: var(--muted);
}

.filter-section {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 25px;
}

.filter-btn {
  padding: 11px 16px;
  border: 1px solid var(--line);
  background: white;
  cursor: pointer;
  font-weight: 700;
}

.filter-btn.active,
.filter-btn:hover {
  background: var(--dark);
  color: white;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.service-card {
  padding: 25px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface);
  transition: .25s ease;
}

.service-card:hover {
  transform: translateY(-5px);
  border-color: var(--accent);
  box-shadow: 0 15px 35px rgba(0,0,0,.07);
}

.service-card h3 {
  margin: 0 0 10px;
}

.service-card p {
  color: var(--muted);
  line-height: 1.6;
}

.service-category {
  display: inline-block;
  margin-bottom: 18px;
  color: var(--accent-dark);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
}

.cta-box {
  margin-top: 70px;
  padding: 55px;
  border-radius: 18px;
  background: var(--dark);
  color: white;
}

.cta-box h2 {
  margin: 0 0 12px;
  font-size: clamp(30px, 4vw, 50px);
}

.cta-box p {
  color: #b9c4bc;
}

@media (max-width: 800px) {
  .hero-split,
  .services-grid {
    grid-template-columns: 1fr;
  }

  .stats-bar {
    grid-template-columns: 1fr;
  }

  .stat-item + .stat-item {
    border-left: 0;
    border-top: 1px solid var(--line);
  }

  .cta-box {
    padding: 35px 25px;
  }
}
